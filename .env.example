# Copy to .env for local overrides. Never commit real secrets.

APP_ENV=development
PORT=8080
DATABASE_URL=postgres://treelot:treelot@localhost:5432/treelot?sslmode=disable
TREE_LOT_TIME_ZONE=America/Los_Angeles
PUBLIC_BASE_URL=http://localhost:8080
SESSION_KEY=0123456789abcdef0123456789abcdef
BOOTSTRAP_ENROLLMENT_TOKEN=bootstrap-enrollment-token-0001
# Set this to the token's fixed RFC3339 deadline before deployment.
BOOTSTRAP_TOKEN_EXPIRES_AT=REPLACE_WITH_RFC3339_UTC_DEADLINE
# WEBAUTHN_RP_ID=localhost
# AUTH_RATE_LIMIT_MAX=10
# AUTH_RATE_LIMIT_WINDOW=15m
GROUPS_IO_ENABLED=false

# Required only when APP_ENV=acceptance
# TEST_CONTROL_KEY=acceptance-test-control-key

# Unit/component tests reset foundation tables in this database.
# The name MUST end with _test. Never point this at the development treelot DB.
# Leave unset to auto-resolve (host :5432 treelot_test, else Compose :5433).
# TEST_DATABASE_URL=postgres://treelot:treelot@127.0.0.1:5433/treelot_test?sslmode=disable
