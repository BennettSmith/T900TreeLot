{{define "bootstrap"}}
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{.PageTitle}}</title>
  <link rel="stylesheet" href="/static/app.css">
  <script src="/static/passkeys.js" defer></script>
</head>
<body class="min-h-screen">
  <a class="skip-link" href="#main">Skip to content</a>
  <header class="border-b border-border bg-surface">
    <div class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-4 py-4">
      <p class="text-lg font-semibold tracking-tight text-text">{{.Brand}}</p>
      <nav aria-label="Primary">
        <ul class="flex flex-wrap items-center gap-4">
          {{range .Navigation}}
          <li><a class="text-sm font-medium text-action hover:text-action-hover" href="{{.Href}}"{{if .Current}} aria-current="page"{{end}}>{{.Label}}</a></li>
          {{end}}
        </ul>
      </nav>
    </div>
  </header>
  <main id="main" class="mx-auto max-w-5xl px-4 py-10">
    <section class="max-w-2xl space-y-6">
      {{if eq .Stage "entry"}}
      <div data-bootstrap-entry>
        <p class="text-sm font-semibold uppercase tracking-wide text-action">First Admin setup</p>
        <h1 class="mt-2 text-3xl font-semibold tracking-tight text-text">Enter the bootstrap token</h1>
        <p class="mt-3 text-base text-text-secondary">Use the one-time enrollment token provided during deployment. The token can be pasted here or captured from a link fragment by your browser.</p>
        {{if .Alert}}{{template "alert" .Alert}}{{end}}
        <form class="mt-8 space-y-4" method="post" action="/bootstrap/start">
          <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
          {{range .Fields}}{{template "field" .}}{{end}}
          {{template "button" (dictButton "Continue" "primary" "submit")}}
        </form>
      </div>
      {{else if eq .Stage "enroll"}}
      <div>
        <p class="text-sm font-semibold uppercase tracking-wide text-action">First Admin setup</p>
        <h1 class="mt-2 text-3xl font-semibold tracking-tight text-text">Claim your administrator profile</h1>
        <p class="mt-3 text-base text-text-secondary">Enter the email you will use as your account identifier and the name shown inside the scheduler.</p>
        {{if .Alert}}{{template "alert" .Alert}}{{end}}
        <form class="mt-8 space-y-4" method="post" action="/bootstrap/claim">
          <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
          <input type="hidden" name="bootstrap_token" value="{{.Token}}">
          {{range .Fields}}{{template "field" .}}{{end}}
          {{template "button" (dictButton "Continue to passkey" "primary" "submit")}}
        </form>
      </div>
      {{else}}
      <div data-bootstrap-passkey data-begin-url="/bootstrap/passkey/begin" data-finish-url="/bootstrap/passkey/finish">
        <p class="text-sm font-semibold uppercase tracking-wide text-action">First Admin setup</p>
        <h1 class="mt-2 text-3xl font-semibold tracking-tight text-text">Register your passkey</h1>
        <p class="mt-3 text-base text-text-secondary">Your browser or device will ask you to create a passkey. The account is created only after that passkey ceremony succeeds.</p>
        {{if .Alert}}{{template "alert" .Alert}}{{end}}
        <form class="mt-8 space-y-4" data-passkey-form>
          <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
          <input type="hidden" name="bootstrap_token" value="{{.Token}}">
          <input type="hidden" name="email" value="{{.Email}}">
          <input type="hidden" name="first_name" value="{{.FirstName}}">
          <input type="hidden" name="last_name" value="{{.LastName}}">
          <input type="hidden" name="preferred_display_name" value="{{.PreferredDisplayName}}">
          <div class="rounded-control border border-border bg-muted px-4 py-3 text-sm text-text">
            <strong>{{.PreferredDisplayName}}</strong>
            <p class="mt-1 text-text-secondary">{{.Email}}</p>
          </div>
          <div class="alert alert--critical" role="alert" data-passkey-error hidden>
            {{template "icon" (printfIcon "critical")}}<div><strong>Passkey registration could not be completed.</strong><p data-passkey-error-message>Try again when your browser is ready.</p></div>
          </div>
          <button class="rounded-control bg-action px-4 py-2 text-sm font-semibold text-white hover:bg-action-hover" type="submit">Create passkey and finish setup</button>
        </form>
      </div>
      {{end}}
    </section>
  </main>
</body>
</html>
{{end}}
