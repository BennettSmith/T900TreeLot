{{define "account-security"}}
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{.PageTitle}}</title>
  <link rel="stylesheet" href="/static/app.css">
  <script src="/static/passkeys.js" defer></script>
</head>
<body class="min-h-screen">
  <a class="skip-link" href="#main">Skip to content</a>
  <header class="border-b border-border bg-surface">
    <div class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-4 py-4">
      <p class="text-lg font-semibold tracking-tight text-text">{{.Brand}}</p>
      <nav aria-label="Primary">
        <ul class="flex flex-wrap items-center gap-4">
          {{range .Navigation}}
          <li><a class="text-sm font-medium text-action hover:text-action-hover" href="{{.Href}}"{{if .Current}} aria-current="page"{{end}}>{{.Label}}</a></li>
          {{end}}
          {{template "sign-out-nav" .CSRFToken}}
        </ul>
      </nav>
    </div>
  </header>
  <main id="main" class="mx-auto max-w-5xl px-4 py-10">
    <section class="max-w-2xl">
      <p class="text-sm font-semibold uppercase tracking-wide text-action">Account security</p>
      <h1 class="mt-2 text-3xl font-semibold tracking-tight text-text">Passkeys and account email</h1>
      <p class="mt-3 text-base text-text-secondary">Confirm with a passkey before changing credentials. Your identity and history stay the same.</p>
      {{if .Message}}
      <p class="mt-4 rounded-control border border-border bg-muted px-4 py-3 text-sm text-text" role="status">{{.Message}}</p>
      {{end}}
      {{if .ErrorMessage}}
      <p class="mt-4 rounded-control border border-border bg-muted px-4 py-3 text-sm text-text" role="alert">{{.ErrorMessage}}</p>
      {{end}}

      {{if .StepUpRequired}}
      <div class="mt-8" data-account-step-up data-begin-url="/account/security/step-up/begin" data-finish-url="/account/security/step-up/finish">
        <h2 class="text-xl font-semibold text-text">Confirm with your passkey</h2>
        <p class="mt-2 text-sm text-text-secondary">A recent passkey confirmation is required before you can manage passkeys or change your account email.</p>
        <div hidden data-passkey-error class="mt-4" role="alert">
          <p data-passkey-error-message class="text-sm text-text"></p>
        </div>
        <form class="mt-4" data-step-up-form>
          <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
          <button type="submit" class="rounded-control bg-action px-4 py-2 text-sm font-medium text-white hover:bg-action-hover">Confirm with passkey</button>
        </form>
      </div>
      {{else}}
      <div class="mt-8 space-y-10">
        <div data-account-passkeys data-begin-url="/account/security/passkeys/begin" data-finish-url="/account/security/passkeys/finish">
          <h2 class="text-xl font-semibold text-text">Passkeys</h2>
          <p class="mt-2 text-sm text-text-secondary">Signed in as {{.PrimaryEmail}}. Keep at least one passkey registered.</p>
          <ul class="mt-4 space-y-2">
            {{range .Passkeys}}
            <li class="flex items-center justify-between gap-4 rounded-control border border-border px-4 py-3">
              <span class="text-sm text-text">Passkey {{.ID}}{{if .CreatedAt}} · {{.CreatedAt}}{{end}}</span>
              <form method="post" action="/account/security/passkeys/remove">
                <input type="hidden" name="csrf_token" value="{{$.CSRFToken}}">
                <input type="hidden" name="credential_id" value="{{.ID}}">
                <button type="submit" class="text-sm font-medium text-action hover:text-action-hover">Remove</button>
              </form>
            </li>
            {{else}}
            <li class="text-sm text-text-secondary">No passkeys found.</li>
            {{end}}
          </ul>
          <div hidden data-passkey-error class="mt-4" role="alert">
            <p data-passkey-error-message class="text-sm text-text"></p>
          </div>
          <form class="mt-4" data-add-passkey-form>
            <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
            <button type="submit" class="rounded-control bg-action px-4 py-2 text-sm font-medium text-white hover:bg-action-hover">Add passkey</button>
          </form>
        </div>

        <div data-account-change-email>
          <h2 class="text-xl font-semibold text-text">Account email</h2>
          <p class="mt-2 text-sm text-text-secondary">Changing email keeps this identity and revokes all browser sessions.</p>
          <form class="mt-4 space-y-3" method="post" action="/account/email">
            <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
            <label class="block text-sm font-medium text-text" for="email">New account email</label>
            <input class="w-full rounded-control border border-border px-3 py-2 text-sm" id="email" name="email" type="email" required autocomplete="username" value="{{.PrimaryEmail}}">
            <button type="submit" class="rounded-control bg-action px-4 py-2 text-sm font-medium text-white hover:bg-action-hover">Change email</button>
          </form>
        </div>
      </div>
      {{end}}
    </section>
  </main>
</body>
</html>
{{end}}
