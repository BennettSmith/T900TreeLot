{{define "home"}}
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{.PageTitle}}</title>
  <link rel="stylesheet" href="/static/app.css">
</head>
<body class="min-h-screen">
  <a class="skip-link" href="#main">Skip to content</a>
  <header class="border-b border-border bg-surface">
    <div class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-4 py-4">
      <p class="text-lg font-semibold tracking-tight text-text">{{.Brand}}</p>
      <nav aria-label="Primary">
        <ul class="flex flex-wrap items-center gap-4">
          {{range .Navigation}}
          <li>
            <a class="text-sm font-medium text-action hover:text-action-hover" href="{{.Href}}"{{if .Current}} aria-current="page"{{end}}>{{.Label}}</a>
          </li>
          {{end}}
        </ul>
      </nav>
    </div>
  </header>
  <main id="main" class="mx-auto max-w-5xl px-4 py-10">
    <section class="max-w-2xl">
      <h1 class="text-3xl font-semibold tracking-tight text-text">{{.Headline}}</h1>
      <p class="mt-3 text-base text-text-secondary">{{.Supporting}}</p>
      {{if .SmokeMessage}}
      <p class="mt-6 rounded-control border border-border bg-muted px-4 py-3 text-sm text-text" role="status">{{.SmokeMessage}}</p>
      {{end}}
      <form class="mt-8 space-y-4" method="post" action="/smoke">
        <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
        <label class="block text-sm font-medium text-text" for="smoke-message">Foundation smoke message</label>
        <input class="w-full rounded-control border border-border bg-surface px-3 py-2 text-sm text-text" id="smoke-message" name="message" type="text" value="{{.SmokeInput}}" autocomplete="off">
        <button class="rounded-control bg-action px-4 py-2 text-sm font-semibold text-white hover:bg-action-hover" type="submit">Submit smoke check</button>
      </form>
    </section>
  </main>
</body>
</html>
{{end}}
